load("//bazel:spl.bzl", "spl_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

spl_binary(
    name = "pyramid_play",
    src = "main.spl",
)

sh_binary(
    name = "ascii3d",
    srcs = ["tools/ascii3d.sh"],
    data = [":pyramid_play", "tools/animate.py"],
    deps = ["@rules_shell//shell/runfiles"],
)

spl_binary(
    name = "gallery",
    src = "gallery.spl",
)

spl_binary(
    name = "arithmetic",
    src = "tests/arithmetic.spl",
    testonly = True,
)

spl_binary(
    name = "control_flow",
    src = "tests/control_flow.spl",
    testonly = True,
)

sh_test(
    name = "renderer_test",
    size = "small",
    srcs = ["tests/run_tests.sh"],
    args = [
        "$(rootpath :gallery)",
        "$(rootpath :arithmetic)",
        "$(rootpath :control_flow)",
    ],
    data = [
        ":gallery",
        ":arithmetic",
        ":control_flow",
        "tests/test_renderer.py",
    ] + glob(["tests/golden/*.txt"], allow_empty = True),
)

sh_test(
    name = "animation_test",
    size = "small",
    srcs = ["tests/run_animation_tests.sh"],
    args = ["$(rootpath :pyramid_play)", "$(rootpath :ascii3d)"],
    data = [
        ":pyramid_play",
        ":ascii3d",
        "tools/animate.py",
        "tests/test_animation.py",
    ],
)

sh_test(
    name = "compiler_test",
    size = "small",
    srcs = ["tests/run_compiler_tests.sh"],
    args = [
        "$(rootpath //third_party/spl:spl2c)",
        "$(rootpath //third_party/spl:spl2c_posix)",
    ],
    data = [
        "//third_party/spl:spl2c",
        "//third_party/spl:spl2c_posix",
        "main.spl",
        "tests/test_compiler.py",
    ],
)
